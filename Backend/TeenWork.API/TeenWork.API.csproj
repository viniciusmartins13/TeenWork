<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TeenWork.API</RootNamespace>
    <UserSecretsId>teenwork-api-dev</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nem todo membro público precisa de comentário XML. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <!-- Necessário para os comandos "dotnet ef" (migrations). Mesma versão do EF Core da solução. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeenWork.Application\TeenWork.Application.csproj" />
    <ProjectReference Include="..\TeenWork.Infrastructure\TeenWork.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Uploads de usuários nunca vão para o build/publish. -->
    <Content Remove="uploads\**" />
    <None Remove="uploads\**" />
  </ItemGroup>
</Project>
